# Where lead forms POST. Empty = simulated (preview/dev only — nothing is sent).
# Production: /api/lead (api/lead.ts emails leads through Resend). Build-time: redeploy after changing.
PUBLIC_LEAD_ENDPOINT=

# Server-side, used by api/lead.ts (set in Vercel → Settings → Environment Variables; never commit values).
# Resend API key ("Sending access" is enough).
RESEND_API_KEY=
# Who receives leads (comma-separated). Default: info@medadx.com
LEAD_TO=
# Sender; its domain must be verified in Resend. Default: Medad-X Website <leads@medadx.com>
LEAD_FROM=
# Safety net while the domain is unverified: leads go from onboarding@resend.dev to this address.
# Must be the Resend account owner's email. Leave empty to disable.
LEAD_FALLBACK_TO=
# Customer confirmation email (quote + trading-account forms). Default sender: Medad-X <leads@medadx.com>
CONFIRM_FROM=
# Set to "off" to stop customer confirmations (e.g. if the form is abused). Redeploy after changing.
LEAD_CONFIRM=
