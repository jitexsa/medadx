{
  "ci": {
    "collect": {
      "startServerCommand": "PORT=4323 node tests/e2e/serve.mjs",
      "startServerReadyPattern": "serving dist",
      "url": [
        "http://localhost:4323/",
        "http://localhost:4323/ar",
        "http://localhost:4323/products/farah",
        "http://localhost:4323/recipes/chicken-kabsa",
        "http://localhost:4323/history-of-rice",
        "http://localhost:4323/contact"
      ],
      "numberOfRuns": 1,
      "settings": { "preset": "perf", "formFactor": "mobile", "screenEmulation": { "mobile": true } }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 200 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
