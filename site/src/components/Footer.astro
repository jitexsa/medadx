---
import { Image } from 'astro:assets';
import logoFull from '@/assets/brand/logo-full.png';
import { SITE_DATA, SOCIALS } from '@/data/site';
import { getDict, localizedPath, type Locale } from '@/i18n';
import { getLegal } from '@/i18n/legal';
import { ui } from '@/i18n/ui';
import { getProducts, productCopy } from '@/lib/catalog';
import { primaryNav } from '@/lib/nav';

export interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDict(locale);
const u = ui(locale);
const nav = primaryNav(locale).filter((n) => n.key !== 'products' && n.key !== 'recipes');
const products = (await getProducts()).map((p) => ({ id: p.id, name: productCopy(p, locale).name }));
const L = (p: string) => localizedPath(p, locale);
const year = new Date().getFullYear();
const lg = getLegal(locale);
const legal = [
  { href: L('/terms'), label: lg.terms.navLabel },
  { href: L('/privacy'), label: lg.privacy.navLabel },
  { href: L('/rice-terms'), label: lg.riceTerms.navLabel },
];
---

<footer class="ftr">
  <div class="ftr__top wrap--wide">
    <div class="ftr__brand">
      <Image src={logoFull} alt="Medad-X General Trading" width={66} height={72} densities={[1, 2, 3]} format="webp" class="ftr__logo" />
      <p class="ftr__desc">{t.footer.desc}</p>
      <div class="ftr__tag">
        <span class="dia dia--sm" aria-hidden="true"></span>
        <span>{t.footer.tagline}</span>
      </div>
      <div class="ftr__social">
        <a href={SOCIALS.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path>
          </svg>
        </a>
        <a href={SOCIALS.instagram} target="_blank" rel="noopener" aria-label="Instagram">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"></path>
          </svg>
        </a>
        <a href={SOCIALS.x} target="_blank" rel="noopener" aria-label="X">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
          </svg>
        </a>
        <a href={SITE_DATA.waHref} target="_blank" rel="noopener" aria-label="WhatsApp" data-track="whatsapp_click">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.693.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.29.173-1.414-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885M20.52 3.449C18.24 1.245 15.24 0 12.045 0 5.463 0 .104 5.334.101 11.892c0 2.096.549 4.14 1.595 5.945L0 24l6.335-1.652a12.062 12.062 0 005.71 1.454h.006c6.585 0 11.946-5.335 11.949-11.896 0-3.176-1.24-6.165-3.495-8.411"></path>
          </svg>
        </a>
      </div>
    </div>

    <div class="ftr__cols">
      <div>
        <h2 class="ftr__h">{t.footer.quickT}</h2>
        <ul class="ftr__list">
          {nav.map((n) => (
            <li>
              <a href={n.href}>{n.label}</a>
            </li>
          ))}
          <li>
            <a href="/recipes" hreflang={locale === 'ar' ? 'en' : undefined}>
              {t.footer.recipes}
            </a>
          </li>
          <li>
            <a href={L('/contact')}>{getDict(locale).nav.items.find((i) => i.path === 'contact')?.label}</a>
          </li>
        </ul>
        <a href={L('/trading-account')} class="ftr__trade">
          <span class="dia dia--md dia--light" aria-hidden="true"></span>
          {t.footer.trading}
        </a>
      </div>
      <div>
        <h2 class="ftr__h">{t.footer.productsT}</h2>
        <ul class="ftr__list">
          {products.map((p) => (
            <li>
              <a href={L(`/products/${p.id}`)}>{p.name}</a>
            </li>
          ))}
          <li>
            <a href={L('/products')}>{u.productPage.compareTitle} →</a>
          </li>
        </ul>
      </div>
      <div>
        <h2 class="ftr__h">{t.footer.legalT}</h2>
        <ul class="ftr__list">
          {legal.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))}
          <li>
            <a href={L('/image-credits')}>{u.imageCredits}</a>
          </li>
        </ul>
      </div>
      <div>
        <h2 class="ftr__h">{t.footer.contactT}</h2>
        <ul class="ftr__list ftr__contact">
          <li>
            <a href={SITE_DATA.phoneHref} dir="ltr" data-track="tel_click">
              {SITE_DATA.phone}
            </a>
          </li>
          <li>
            <a href={SITE_DATA.waHref} target="_blank" rel="noopener" dir="ltr" data-track="whatsapp_click">
              {SITE_DATA.wa}
            </a>
          </li>
          <li>
            <a href={SITE_DATA.emailHref} dir="ltr">
              {SITE_DATA.email}
            </a>
          </li>
        </ul>
        <address class="ftr__addr">{t.footer.addr}</address>
      </div>
    </div>
  </div>
  <div class="ftr__bottom">
    <div class="ftr__bottom-in wrap--wide">
      <span>
        © {year} Medad-X. {t.footer.rights}.
      </span>
      <div class="ftr__legal">
        {legal.map((l) => (
          <a href={l.href}>{l.label}</a>
        ))}
        <span class="ftr__domain">medadx.com</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .ftr {
    background: #122619;
    color: #efe9d8;
    border-top: 3px solid var(--gold-500);
  }
  .ftr__top {
    margin-inline: auto;
    padding: clamp(38px, 5vw, 58px) var(--gutter) 30px;
    display: flex;
    flex-wrap: wrap;
    gap: clamp(30px, 4vw, 60px);
    align-items: flex-start;
  }
  .ftr__brand {
    flex: 1 1 240px;
    min-width: 0;
    max-width: 330px;
  }
  .ftr__logo {
    height: 72px;
    width: auto;
    margin-bottom: 13px;
  }
  .ftr__desc {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.6;
    color: rgba(239, 233, 216, 0.72);
    max-width: 300px;
  }
  .ftr__tag {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: 14px;
    white-space: nowrap;
    border: 1px solid rgba(194, 154, 69, 0.45);
    border-radius: 999px;
    padding: 6px 13px;
    font-family: var(--f-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: var(--tr-wide);
    text-transform: uppercase;
    color: #d9bc72;
  }
  .ftr__social {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-top: 22px;
  }
  .ftr__social a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 11px;
    border: 1px solid rgba(239, 233, 216, 0.16);
    color: rgba(239, 233, 216, 0.72);
    transition:
      border-color 0.2s,
      color 0.2s,
      background 0.2s;
  }
  .ftr__social a:hover {
    border-color: rgba(194, 154, 69, 0.6);
    color: #f1e9d2;
    background: rgba(194, 154, 69, 0.12);
  }
  .ftr__cols {
    flex: 2 1 560px;
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: clamp(16px, 2vw, 28px);
  }
  .ftr__h {
    margin: 0 0 12px;
    font-family: var(--f-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: var(--tr-wide);
    text-transform: uppercase;
    color: var(--gold-500);
  }
  .ftr__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .ftr__list a {
    color: rgba(239, 233, 216, 0.8);
    text-decoration: none;
    font-size: 14px;
    line-height: 1.4;
    transition: color 0.2s;
  }
  .ftr__list a:hover,
  .ftr__legal a:hover {
    color: #fff;
  }
  .ftr__contact a {
    font-family: var(--f-mono);
    font-size: 13px;
    color: rgba(239, 233, 216, 0.85);
  }
  .ftr__addr {
    margin: 14px 0 0;
    font-style: normal;
    font-size: 13px;
    line-height: 1.65;
    color: rgba(239, 233, 216, 0.72);
    max-width: 230px;
  }
  .ftr__trade {
    margin-top: 14px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1.5px solid rgba(201, 162, 75, 0.55);
    color: var(--sand);
    text-decoration: none;
    border-radius: 10px;
    padding: 9px 14px;
    font-size: 13.5px;
    font-weight: 650;
    transition:
      border-color 0.2s,
      background 0.2s;
  }
  .ftr__trade:hover {
    border-color: var(--gold-400);
    background: rgba(201, 162, 75, 0.12);
  }
  .ftr__bottom {
    border-top: 1px solid rgba(239, 233, 216, 0.14);
  }
  .ftr__bottom-in {
    margin-inline: auto;
    padding: 20px var(--gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    font-size: 13px;
    color: rgba(239, 233, 216, 0.6);
  }
  .ftr__legal {
    display: flex;
    align-items: center;
    gap: clamp(14px, 2vw, 22px);
    flex-wrap: wrap;
  }
  .ftr__legal a {
    font-size: 12.5px;
    color: rgba(239, 233, 216, 0.62);
    text-decoration: none;
    transition: color 0.2s;
  }
  .ftr__domain {
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(239, 233, 216, 0.62);
  }
</style>
