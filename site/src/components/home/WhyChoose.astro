---
import { Image } from 'astro:assets';
import basmati from '@/assets/brand/premium-basmati-crop.png';
import { getDict, type Locale } from '@/i18n';

export interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDict(locale);
const ar = locale === 'ar';
const wi = t.why.items;
const feature = wi[0]!;
const cards = wi.slice(1).map((w, i) => ({ n: `0${i + 2}`, ...w, rev: Math.min(i + 2, 4) }));
const countLabel = ar ? `${wi.length} أسباب` : `0${wi.length} — Reasons`;
---

<section class="section why cv-auto">
  <div class="why__dots" aria-hidden="true"></div>
  <div class="wrap why__in">
    <div class="why__head" data-reveal="0">
      <div class="why__title">
        <div class="kicker">
          <span class="dia" aria-hidden="true"></span>
          <span class="kicker__text">{t.why.label}</span>
        </div>
        <h2 class="h2 h2--lg">{t.why.title}</h2>
      </div>
      <div class="why__count">
        <span aria-hidden="true"></span>
        {countLabel}
      </div>
    </div>
    <div class="why__grid">
      <div class="why__feature" data-reveal="1">
        <Image
          src={basmati}
          alt="Premium Medad-X basmati rice served in a brass bowl beside a branded rice bag"
          format="webp"
          widths={[420, 640, 837]}
          sizes="(min-width: 1240px) 600px, (min-width: 700px) 48vw, 92vw"
          class="why__img"
        />
        <div class="why__shade" aria-hidden="true"></div>
        <div class="why__grain" aria-hidden="true"></div>
        <div class="why__glow" aria-hidden="true"></div>
        <div class="why__ring" aria-hidden="true"></div>
        <div class="why__ftop">
          <span class="why__fnum">01</span>
          <span class="why__fbadge" aria-hidden="true">
            <span class="dia dia--lg dia--light"></span>
          </span>
        </div>
        <div class="why__fcopy">
          <h3>{feature.t}</h3>
          <p>{feature.d}</p>
        </div>
      </div>
      <div class="why__cards">
        {cards.map((c) => (
          <div class="why__card" data-reveal={c.rev}>
            <div class="why__card-glow" aria-hidden="true" />
            <div class="why__card-top">
              <span class="why__cnum">{c.n}</span>
              <span class="dia" aria-hidden="true" />
            </div>
            <h3>{c.t}</h3>
            <p>{c.d}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .why {
    position: relative;
    background: var(--bg);
    overflow: hidden;
  }
  .why__dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(31, 61, 42, 0.05) 1px, transparent 1.3px);
    background-size: 24px 24px;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(180deg, transparent, #000 26%, #000 74%, transparent);
    mask-image: linear-gradient(180deg, transparent, #000 26%, #000 74%, transparent);
  }
  .why__in {
    position: relative;
  }
  .why__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    margin-bottom: clamp(32px, 4vw, 52px);
  }
  .why__title {
    max-width: 600px;
  }
  .why__count {
    display: flex;
    align-items: center;
    gap: 11px;
    font-family: var(--f-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(var(--ink), 0.68);
    padding-bottom: 6px;
  }
  .why__count span {
    width: 30px;
    height: 1.5px;
    background: rgba(166, 127, 46, 0.6);
  }
  .why__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(290px, 100%), 1fr));
    gap: 16px;
    align-items: stretch;
  }
  .why__feature {
    position: relative;
    overflow: hidden;
    border-radius: 24px;
    padding: clamp(28px, 3vw, 42px);
    background: linear-gradient(158deg, #22422d, #12261a);
    color: var(--cream);
    min-height: 340px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 34px 66px rgba(19, 39, 25, 0.3);
  }
  .why__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .why__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(0deg, rgba(11, 24, 16, 0.94) 0%, rgba(12, 26, 18, 0.62) 26%, rgba(12, 26, 18, 0.12) 52%, rgba(12, 26, 18, 0.22) 100%),
      linear-gradient(90deg, rgba(11, 24, 16, 0.72) 0%, rgba(12, 26, 18, 0.28) 30%, rgba(12, 26, 18, 0) 55%);
  }
  [dir='rtl'] .why__shade {
    background:
      linear-gradient(0deg, rgba(11, 24, 16, 0.94) 0%, rgba(12, 26, 18, 0.62) 26%, rgba(12, 26, 18, 0.12) 52%, rgba(12, 26, 18, 0.22) 100%),
      linear-gradient(270deg, rgba(11, 24, 16, 0.72) 0%, rgba(12, 26, 18, 0.28) 30%, rgba(12, 26, 18, 0) 55%);
  }
  .why__grain {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(238, 230, 205, 0.06) 1px, transparent 1.3px);
    background-size: 20px 20px;
  }
  .why__glow {
    position: absolute;
    top: -80px;
    inset-inline-end: -70px;
    width: 280px;
    height: 280px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(201, 162, 75, 0.3), transparent 62%);
  }
  .why__ring {
    position: absolute;
    bottom: -40px;
    inset-inline-start: -40px;
    width: 150px;
    height: 150px;
    border: 1px solid rgba(201, 162, 75, 0.16);
    border-radius: 50%;
  }
  .why__ftop {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
  }
  .why__fnum {
    font-family: var(--f-display);
    font-size: clamp(66px, 8vw, 112px);
    font-weight: 800;
    font-stretch: 70%;
    line-height: 0.82;
    color: var(--gold-400);
    letter-spacing: -0.01em;
  }
  .why__fbadge {
    flex: none;
    width: 48px;
    height: 48px;
    border: 1px solid rgba(201, 162, 75, 0.5);
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 6px;
  }
  .why__fcopy {
    position: relative;
  }
  .why__fcopy h3 {
    margin: 0;
    font-size: clamp(23px, 2.4vw, 32px);
    font-weight: 750;
    font-stretch: 112%;
    line-height: 1.15;
    letter-spacing: var(--tr-tight);
    color: var(--cream-2);
    text-wrap: balance;
  }
  .why__fcopy p {
    margin: 15px 0 0;
    font-size: 15px;
    line-height: 1.65;
    color: rgba(238, 230, 205, 0.74);
    max-width: 360px;
  }
  .why__cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(188px, 1fr));
    gap: 16px;
  }
  .why__card {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(var(--ink), 0.13);
    border-radius: 20px;
    padding: clamp(20px, 2.1vw, 26px);
    background: var(--surface);
    display: flex;
    flex-direction: column;
    gap: 11px;
    min-height: 158px;
    transition:
      transform 0.38s var(--ease),
      box-shadow 0.38s,
      border-color 0.38s;
  }
  .why__card:hover {
    transform: translateY(-6px);
    box-shadow: 0 26px 46px rgba(var(--ink), 0.13);
    border-color: rgba(166, 127, 46, 0.55);
  }
  .why__card-glow {
    position: absolute;
    top: -30px;
    inset-inline-end: -30px;
    width: 110px;
    height: 110px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(166, 127, 46, 0.09), transparent 65%);
  }
  .why__card-top {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .why__card-top .dia {
    opacity: 0.75;
  }
  .why__cnum {
    font-family: var(--f-display);
    font-size: 36px;
    font-weight: 800;
    font-stretch: 70%;
    line-height: 1;
    color: var(--gold-text);
  }
  .why__card h3 {
    position: relative;
    margin: 0;
    font-size: 16.5px;
    font-weight: 720;
    line-height: 1.3;
    color: var(--ink-solid);
    text-wrap: balance;
  }
  .why__card p {
    position: relative;
    margin: 0;
    font-size: 13.5px;
    line-height: 1.58;
    color: rgba(var(--ink), 0.68);
  }
</style>
