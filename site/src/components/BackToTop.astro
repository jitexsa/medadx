---
import { getDict, type Locale } from '@/i18n';
export interface Props {
  locale: Locale;
}
const label = getDict(Astro.props.locale).ux.top;
---

<button type="button" class="totop" aria-label={label} title={label} data-totop>
  <svg width="50" height="50" viewBox="0 0 50 50" aria-hidden="true" class="totop__ring">
    <circle cx="25" cy="25" r="21" fill="none" class="totop__track" stroke-width="2.5"></circle>
    <circle
      cx="25"
      cy="25"
      r="21"
      fill="none"
      class="totop__bar"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-dasharray="131.95"
      stroke-dashoffset="131.95"
      data-totop-ring
    ></circle>
  </svg>
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="totop__arrow">
    <path
      d="M12 19 V5 M5.5 11.5 L12 5 L18.5 11.5"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    ></path>
  </svg>
</button>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-totop]');
  const ring = document.querySelector<SVGCircleElement>('[data-totop-ring]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  let raf = 0;
  const update = () => {
    raf = 0;
    const y = window.scrollY;
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const pct = max > 0 ? Math.min(1, Math.max(0, y / max)) : 0;
    ring?.style.setProperty('stroke-dashoffset', String(131.95 * (1 - pct)));
    btn?.classList.toggle('is-on', y > 700);
  };
  window.addEventListener('scroll', () => (raf ||= requestAnimationFrame(update)), { passive: true });
  update();
  btn?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: reduce.matches ? 'auto' : 'smooth' });
    document.getElementById('main')?.focus({ preventScroll: true });
  });
</script>

<style>
  .totop {
    position: fixed;
    z-index: 81;
    inset-inline-end: clamp(12px, 2vw, 26px);
    bottom: 22px;
    width: 50px;
    height: 50px;
    padding: 0;
    border-radius: 50%;
    border: none;
    background: var(--card);
    color: var(--ink-solid);
    box-shadow: 0 12px 30px rgba(var(--ink), 0.2);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transform: translateY(12px) scale(0.9);
    transition:
      opacity 0.3s,
      transform 0.3s,
      bottom 0.4s var(--ease-out);
  }
  .totop:global(.is-on) {
    opacity: 1;
    pointer-events: auto;
    transform: none;
  }
  :global(body.has-sticky) .totop {
    bottom: 92px;
  }
  @media (min-width: 700px) {
    :global(body.has-sticky) .totop {
      bottom: 22px;
    }
  }
  .totop__ring {
    position: absolute;
    inset: 0;
    transform: rotate(-90deg);
  }
  .totop__track {
    stroke: rgba(var(--ink), 0.12);
  }
  .totop__bar {
    stroke: var(--gold-500);
  }
  .totop__arrow {
    position: relative;
  }
</style>
