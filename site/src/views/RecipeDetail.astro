---
import { getImage, Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import RecipeCard from '@/components/recipes/RecipeCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ui } from '@/i18n/ui';
import { getCredits, getRecipes, productCopy, type Recipe } from '@/lib/catalog';
import { breadcrumbs, recipe as recipeSchema } from '@/lib/schema';
import { ogPath } from '@/lib/seo';

export interface Props {
  recipe: Recipe;
}
const { recipe: r } = Astro.props;
const u = ui('en');
const path = `/recipes/${r.slug}`;
const credits = await getCredits();
const credit = credits.get(`recipes/${r.slug}`);
const all = await getRecipes();
const related = all.filter((x) => x.region === r.region && x.slug !== r.slug).slice(0, 3);
const prod = (await getEntry(r.recommendedProduct))!.data;
const pc = productCopy(prod, 'en');
const ingCount = r.ingredients.reduce((n, g) => n + g.items.length, 0);

// Recipe rich results want large images in several aspect ratios.
const [img1x1, img4x3, img16x9] = await Promise.all([
  getImage({ src: r.image, width: 1200, height: 1200, fit: 'cover', format: 'jpeg' }),
  getImage({ src: r.image, width: 1200, height: 900, fit: 'cover', format: 'jpeg' }),
  getImage({ src: r.image, width: 1200, height: 675, fit: 'cover', format: 'jpeg' }),
]);
const title = `${r.title} Recipe | Medad-X Kitchen`;
const description =
  r.tagline.length > 150 ? r.tagline : `${r.tagline} ${r.cuisine} recipe · serves ${r.servings} · ${r.totalTime.split('(')[0]!.trim()}.`;
const jsonLd = [
  recipeSchema({
    title: r.title,
    description: r.tagline,
    path,
    images: [img1x1.src, img4x3.src, img16x9.src, ogPath(path, 'en')],
    prepISO: r.prepISO,
    cookISO: r.cookISO,
    totalISO: r.totalISO,
    servings: r.servings,
    category: r.category,
    cuisine: r.cuisine,
    ingredients: r.ingredients.flatMap((g) => g.items),
    method: r.method,
    keywords: [r.title, r.cuisine, r.region, 'basmati rice', 'rice recipe'],
  }),
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Recipes', path: '/recipes' },
    { name: r.title, path },
  ]),
];
const facts = [
  { k: 'Servings', v: String(r.servings), id: 'serves' },
  { k: 'Prep', v: r.prepTime },
  { k: 'Cook', v: r.cookTime },
  { k: 'Total', v: r.totalTime },
  { k: 'Difficulty', v: r.difficulty },
  { k: 'Rice', v: r.rice },
];
---

<BaseLayout
  locale="en"
  path={path}
  title={title}
  description={description}
  active="recipes"
  ogType="article"
  ogImageAlt={r.imageAlt}
  jsonLd={jsonLd}
>
  <article class="rd" data-recipe-root data-base={r.servings}>
    <section class="rd-hero">
      <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Recipes', href: '/recipes' }, { name: r.title }]} />
      <figure class="rd-fig">
        <div class="rd-fig__media">
          <Image
            src={r.image}
            alt={r.imageAlt}
            format="webp"
            widths={[640, 960, 1200, 1600]}
            sizes="(min-width: 1200px) 1112px, 94vw"
            loading="eager"
            fetchpriority="high"
            class="rd-fig__img"
          />
          <div class="rd-fig__shade" aria-hidden="true"></div>
          <div class="rd-fig__copy">
            <span class="rd-cuisine">
              <span class="dia" aria-hidden="true"></span>
              {r.cuisine}
            </span>
            <h1 class="rd-h1">{r.title}</h1>
            <p class="rd-tag">{r.tagline}</p>
          </div>
        </div>
        {credit && (
          <figcaption class="rd-credit">
            {r.standInImage && <span class="rd-credit__ill">{u.illustrative} · </span>}
            {u.photo}: {credit.artist} ·{' '}
            {credit.licenseUrl ? (
              <a href={credit.licenseUrl} target="_blank" rel="noopener license">
                {credit.license}
              </a>
            ) : (
              credit.license
            )}{' '}
            ·{' '}
            <a href={credit.sourceUrl} target="_blank" rel="noopener">
              Wikimedia Commons
            </a>
          </figcaption>
        )}
      </figure>
    </section>

    <section class="rd-intro">
      <p class="rd-intro__p">{r.intro}</p>
      <dl class="rd-facts">
        {facts.map((f) => (
          <div>
            <dt>{f.k}</dt>
            <dd data-serves-out={f.id === 'serves' ? '' : undefined}>{f.v}</dd>
          </div>
        ))}
      </dl>
    </section>

    <nav class="rd-jump" aria-label="Recipe sections">
      <div class="rd-jump__in">
        <a href="#ingredients">Ingredients</a>
        <a href="#method">Method</a>
        <div class="rd-jump__tools">
          <button type="button" data-rd-print>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M7 9V4h10v5 M7 18H5a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2h-2 M7 15h10v5H7z"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linejoin="round"
              ></path>
            </svg>
            <span>Print</span>
          </button>
          <button type="button" data-rd-share data-title={r.title}>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="18" cy="5" r="2.6" stroke="currentColor" stroke-width="1.7"></circle>
              <circle cx="6" cy="12" r="2.6" stroke="currentColor" stroke-width="1.7"></circle>
              <circle cx="18" cy="19" r="2.6" stroke="currentColor" stroke-width="1.7"></circle>
              <path d="M8.3 10.7 15.7 6.3 M8.3 13.3 15.7 17.7" stroke="currentColor" stroke-width="1.7"></path>
            </svg>
            <span>{u.share}</span>
          </button>
        </div>
      </div>
    </nav>

    <section class="rd-body">
      <div class="rd-rail" id="ingredients">
        <div class="rd-ing">
          <div class="rd-ing__head">
            <div class="rd-ing__top">
              <h2>Ingredients</h2>
              <span class="mono">{ingCount} items</span>
            </div>
            <div class="rd-scale">
              <button type="button" data-serve="-1" aria-label="Fewer servings">
                −
              </button>
              <div class="rd-scale__v" aria-live="polite">
                <span data-serves>{r.servings}</span>
                <span class="label">Servings</span>
              </div>
              <button type="button" data-serve="1" aria-label="More servings">
                +
              </button>
            </div>
            <p class="rd-scale__note" data-scaled-note hidden>
              Scaled from {r.servings} servings. Quantities are approximate — adjust spices to taste.
            </p>
          </div>
          <div class="rd-ing__list">
            {r.ingredients.map((g, gi) => (
              <fieldset class="rd-group">
                {g.group && <legend>{g.group}</legend>}
                {g.items.map((it, ii) => (
                  <label class="rd-item">
                    <input type="checkbox" class="rd-item__cb" data-key={`${gi}-${ii}`} />
                    <span class="rd-box" aria-hidden="true" />
                    <span class="rd-item__t" data-qty={it}>
                      {it}
                    </span>
                  </label>
                ))}
              </fieldset>
            ))}
          </div>
        </div>
        <a href={`/products/${prod.id}`} class="rd-prod" data-product={prod.id}>
          <Image src={prod.journeyBag} alt="" format="webp" height={180} class="rd-prod__img" />
          <span class="rd-prod__copy">
            <span class="label">{u.recipes.byProduct}</span>
            <span class="rd-prod__name">{pc.name}</span>
            <span class="rd-prod__type">
              <span class="dot" aria-hidden="true"></span>
              {pc.type} · {pc.grain}
            </span>
          </span>
        </a>
      </div>

      <div class="rd-method" id="method">
        <h2>Method</h2>
        <p class="rd-method__hint">Tick a step to mark it done.</p>
        <ol class="rd-steps">
          {r.method.map((s, i) => (
            <li id={`step-${i + 1}`}>
              <label class="rd-step">
                <input type="checkbox" class="rd-step__cb" />
                <span class="rd-step__n" aria-hidden="true">
                  <span class="n">{i + 1}</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" class="tick">
                    <path d="M5 12.5 L10 17.5 L19 6.5" stroke="#FCFAF3" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
                <span class="sr-only">Step {i + 1}: </span>
                <span class="rd-step__t">{s}</span>
              </label>
            </li>
          ))}
        </ol>

        {r.tips.length > 0 && (
          <aside class="rd-tips">
            <h3>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path
                  d="M12 3a6 6 0 0 0-3.5 10.9c.5.4.8 1 .8 1.6v.5h5.4v-.5c0-.6.3-1.2.8-1.6A6 6 0 0 0 12 3Z"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linejoin="round"
                />
                <path d="M9.5 19h5 M10.5 21.5h3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
              </svg>
              Chef’s tips
            </h3>
            <ul>
              {r.tips.map((tp) => (
                <li>{tp}</li>
              ))}
            </ul>
          </aside>
        )}
        <div class="rd-serve">
          <div class="kicker">
            <span class="dia" aria-hidden="true"></span>
            <span class="kicker__text">To serve</span>
          </div>
          <p>{r.toServe}</p>
        </div>
      </div>
    </section>

    {related.length > 0 && (
      <section class="rd-related">
        <div class="kicker">
          <span class="dia" aria-hidden="true" />
          <h2 class="rd-related__h">More {r.region} recipes</h2>
        </div>
        <ul class="rd-related__grid">
          {related.map((x) => (
            <RecipeCard recipe={x} headingLevel="h3" compact />
          ))}
        </ul>
      </section>
    )}
  </article>
  <div class="rd-toast" role="status" aria-live="polite" data-rd-toast hidden>
    {u.linkCopied}
  </div>
</BaseLayout>

<script>
  import '@/scripts/recipe-tools';
</script>

<style>
  .rd {
    background: linear-gradient(#f4ecd8, #eee2c7 40%, #f4ecd8);
    padding-bottom: clamp(48px, 6vw, 80px);
  }
  :global(:root[data-theme='dark']) .rd {
    background: var(--bg);
  }
  .rd-hero,
  .rd-intro,
  .rd-body,
  .rd-related {
    max-width: 1200px;
    margin: 0 auto;
    padding-inline: var(--gutter);
  }
  .rd-hero {
    padding-top: calc(var(--header-h) + 22px);
  }
  .rd-fig {
    margin: 16px 0 0;
  }
  .rd-fig__media {
    position: relative;
    border-radius: 22px;
    overflow: hidden;
    border: 1px solid rgba(var(--ink), 0.14);
    box-shadow: 0 34px 70px -40px rgba(31, 45, 29, 0.6);
    aspect-ratio: 16 / 7;
    min-height: 300px;
    background: rgba(var(--ink), 0.06);
  }
  .rd-fig__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .rd-fig__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(13, 31, 20, 0.05) 30%, rgba(13, 31, 20, 0.78));
  }
  .rd-fig__copy {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    padding: clamp(20px, 4vw, 44px);
  }
  .rd-cuisine {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--f-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #e8ce84;
  }
  .rd-h1 {
    margin: 12px 0 0;
    font-family: var(--f-display);
    font-size: clamp(30px, 5.5vw, 58px);
    line-height: 1.02;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #fcfaf3;
    text-wrap: balance;
    max-width: 20ch;
    text-shadow: 0 2px 30px rgba(0, 0, 0, 0.35);
  }
  .rd-tag {
    margin: 12px 0 0;
    max-width: 52ch;
    font-size: clamp(15px, 1.6vw, 19px);
    line-height: 1.5;
    color: rgba(252, 250, 243, 0.9);
  }
  .rd-credit {
    margin-top: 8px;
    font-size: 11.5px;
    color: rgba(var(--ink), 0.68);
  }
  .rd-credit a {
    color: inherit;
  }
  .rd-credit__ill {
    font-weight: 650;
    color: var(--gold-text);
  }
  .rd-intro {
    padding-top: clamp(22px, 3.4vw, 36px);
  }
  .rd-intro__p {
    margin: 0;
    max-width: 70ch;
    font-size: clamp(17px, 1.8vw, 20px);
    line-height: 1.72;
    color: rgba(var(--ink), 0.88);
  }
  .rd-facts {
    margin: 30px 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1px;
    background: rgba(var(--ink), 0.12);
    border: 1px solid rgba(var(--ink), 0.12);
    border-radius: 16px;
    overflow: hidden;
  }
  .rd-facts div {
    background: var(--surface);
    padding: 16px 18px;
  }
  .rd-facts dt {
    font-family: var(--f-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(var(--ink), 0.68);
  }
  .rd-facts dd {
    margin: 3px 0 0;
    font-size: 15px;
    font-weight: 700;
    color: var(--brand-text);
    line-height: 1.3;
  }
  .rd-jump {
    position: sticky;
    top: calc(var(--header-h) + 6px);
    z-index: 30;
    max-width: 1200px;
    margin: 22px auto 0;
    padding: 0 var(--gutter);
  }
  .rd-jump__in {
    display: flex;
    gap: 8px;
    padding: 9px;
    background: rgba(var(--surf), 0.92);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(var(--ink), 0.12);
    border-radius: 14px;
    box-shadow: 0 10px 26px -18px rgba(31, 45, 29, 0.5);
    overflow-x: auto;
  }
  .rd-jump__in > a {
    flex: none;
    padding: 9px 16px;
    color: var(--brand-text);
    font-size: 13.5px;
    font-weight: 650;
    border-radius: 9px;
    text-decoration: none;
  }
  .rd-jump__in > a:hover {
    background: rgba(31, 61, 42, 0.08);
  }
  .rd-jump__tools {
    margin-inline-start: auto;
    display: flex;
    gap: 6px;
  }
  .rd-jump__tools button {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 9px 13px;
    border: 1.5px solid rgba(var(--ink), 0.16);
    background: var(--surface);
    color: var(--brand-text);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    border-radius: 9px;
  }
  .rd-body {
    padding-top: clamp(24px, 3vw, 38px);
    display: flex;
    flex-wrap: wrap;
    gap: clamp(28px, 4vw, 52px);
    align-items: flex-start;
  }
  .rd-rail {
    flex: 1 1 320px;
    min-width: min(100%, 300px);
    max-width: 390px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    scroll-margin-top: 140px;
  }
  @media (min-width: 900px) {
    .rd-rail {
      position: sticky;
      top: 140px;
    }
  }
  .rd-ing {
    background: var(--surface);
    border: 1px solid rgba(var(--ink), 0.13);
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 16px 36px -26px rgba(31, 45, 29, 0.5);
  }
  .rd-ing__head {
    padding: 20px 22px;
    border-bottom: 1px solid rgba(var(--ink), 0.1);
  }
  .rd-ing__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .rd-ing__top h2,
  .rd-method h2 {
    margin: 0;
    font-family: var(--f-display);
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--brand-text);
  }
  .rd-ing__top .mono {
    font-size: 11px;
    letter-spacing: 0.06em;
    color: rgba(var(--ink), 0.68);
  }
  .rd-scale {
    margin-top: 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 6px;
    background: rgba(31, 61, 42, 0.05);
    border-radius: 12px;
  }
  .rd-scale button {
    width: 38px;
    height: 38px;
    flex: none;
    border: 1.5px solid rgba(var(--ink), 0.16);
    background: var(--surface);
    color: var(--brand-text);
    border-radius: 10px;
    font-size: 20px;
    font-weight: 700;
    cursor: pointer;
  }
  .rd-scale__v {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1.1;
  }
  .rd-scale__v [data-serves] {
    font-size: 19px;
    font-weight: 800;
    color: var(--brand-text);
  }
  .rd-scale__note {
    margin: 10px 2px 0;
    font-size: 11.5px;
    line-height: 1.4;
    color: rgba(var(--ink), 0.68);
  }
  .rd-ing__list {
    padding: 8px 12px 14px;
  }
  .rd-group {
    border: 0;
    margin: 10px 0 0;
    padding: 0;
  }
  .rd-group legend {
    padding: 6px 10px 4px;
    font-family: var(--f-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold-text);
    font-weight: 600;
  }
  .rd-item,
  .rd-step {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 11px;
    padding: 9px 10px;
    border-radius: 9px;
    cursor: pointer;
  }
  .rd-item:hover {
    background: rgba(31, 61, 42, 0.05);
  }
  .rd-item__cb,
  .rd-step__cb {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }
  .rd-box {
    flex: none;
    width: 19px;
    height: 19px;
    margin-top: 1px;
    border-radius: 6px;
    border: 1.7px solid rgba(var(--ink), 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s;
  }
  .rd-item__cb:checked + .rd-box {
    background: var(--green-900);
    border-color: var(--green-900);
  }
  .rd-item__cb:checked + .rd-box::after {
    content: '';
    width: 5px;
    height: 9px;
    border: solid #fcfaf3;
    border-width: 0 2.5px 2.5px 0;
    transform: rotate(45deg) translate(-1px, -1px);
  }
  .rd-item__cb:focus-visible + .rd-box,
  .rd-step__cb:focus-visible ~ .rd-step__n {
    outline: 3px solid var(--gold-500);
    outline-offset: 2px;
  }
  .rd-item__t {
    font-size: 14.5px;
    line-height: 1.45;
  }
  .rd-item__cb:checked ~ .rd-item__t {
    color: rgba(var(--ink), 0.68);
    text-decoration: line-through;
  }
  .rd-prod {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 18px;
    background: var(--card);
    border: 1px solid rgba(var(--ink), 0.13);
    border-top: 4px solid var(--accent);
    border-radius: 16px;
    text-decoration: none;
    transition: transform 0.25s;
  }
  .rd-prod:hover {
    transform: translateY(-3px);
  }
  .rd-prod__img {
    flex: none;
    height: 92px;
    width: auto;
    filter: drop-shadow(0 10px 14px rgba(var(--ink), 0.22));
  }
  .rd-prod__copy {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .rd-prod__name {
    font-family: var(--f-head);
    font-size: 17px;
    font-weight: 750;
    line-height: 1.2;
  }
  .rd-prod__type {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 12.5px;
    color: rgba(var(--ink), 0.68);
  }
  .rd-method {
    flex: 3 1 460px;
    min-width: min(100%, 320px);
    scroll-margin-top: 140px;
  }
  .rd-method h2 {
    font-size: 26px;
  }
  .rd-method__hint {
    margin: 6px 0 22px;
    font-size: 13.5px;
    color: rgba(var(--ink), 0.68);
  }
  .rd-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .rd-steps li {
    scroll-margin-top: 140px;
  }
  .rd-step {
    gap: 16px;
    padding: 18px 20px;
    background: var(--surface);
    border: 1px solid rgba(var(--ink), 0.12);
    border-radius: 16px;
    transition:
      background 0.18s,
      border-color 0.18s;
  }
  .rd-step:has(.rd-step__cb:checked) {
    background: rgba(31, 61, 42, 0.05);
    border-color: rgba(31, 61, 42, 0.25);
  }
  .rd-step__n {
    flex: none;
    width: 38px;
    height: 38px;
    border-radius: 11px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--f-mono);
    font-weight: 600;
    font-size: 15px;
    background: rgba(194, 154, 69, 0.16);
    color: var(--gold-text);
    transition: all 0.18s;
  }
