---
import CertSeals from '@/components/CertSeals.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getDict, localizedPath, type Locale } from '@/i18n';
import { ui } from '@/i18n/ui';
import { breadcrumbs, webPage } from '@/lib/schema';

export interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDict(locale);
const u = ui(locale);
const m = u.meta.supply;
const S = t.supplyPage;
const href = (p: string) => localizedPath(p, locale);
const label = t.nav.items.find((i) => i.path === 'supply-chain')?.label ?? S.heroT;
const jsonLd = [
  {
    ...webPage('WebPage', m.title, href('/supply-chain'), locale),
    mainEntity: {
      '@type': 'HowTo',
      name: S.procTitle,
      step: S.steps.map((s, i) => ({ '@type': 'HowToStep', position: i + 1, name: s.t, text: s.d })),
    },
  },
  breadcrumbs([
    { name: u.breadcrumbHome, path: href('/') },
    { name: label, path: href('/supply-chain') },
  ]),
];
---

<BaseLayout locale={locale} path="/supply-chain" title={m.title} description={m.description} active="supply-chain" jsonLd={jsonLd}>
  <section class="sc-hero page-top">
    <div class="wrap">
      <div class="kicker">
        <span class="dia" aria-hidden="true"></span>
        <span class="kicker__text">{S.procLabel}</span>
      </div>
      <h1 class="h1 sc-h1">{S.heroT}</h1>
      <p class="sc-sub">{S.heroSub}</p>
      <p class="sc-intro">{S.intro}</p>
    </div>
  </section>

  <section class="section--tight sc-proc">
    <div class="wrap">
      <h2 class="h2 h2--md sc-proc__h" data-reveal="0">
        {S.procTitle}
      </h2>
      <ol class="sc-steps" data-steps>
        {S.steps.map((s, i) => (
          <li class="sc-step" data-step={i} id={`step-${i + 1}`}>
            <div class="sc-step__rail">
              <span class="sc-step__n">0{i + 1}</span>
              <span class="sc-step__line" aria-hidden="true" />
            </div>
            <div class="sc-step__card">
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section--tight sc-certs">
    <div class="wrap">
      <div class="kicker kicker--light">
        <span class="dia" aria-hidden="true"></span>
        <span class="kicker__text">{S.certLabel}</span>
      </div>
      <h2 class="h2 h2--md h2--light sc-certs__h">{S.certTitle}</h2>
      <CertSeals locale={locale} />
      <p class="sc-certs__note">{S.note}</p>
      <div class="sc-certs__cta">
        <a href={href('/contact')} class="btn btn--gold">
          {t.productsPage.ctaBtn}
        </a>
        <a href={href('/products')} class="btn btn--outline-light">
          {u.productPage.compareTitle}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Highlight steps up to the one crossing 60% of the viewport (ported from updateScrollUi).
  const steps = Array.from(document.querySelectorAll<HTMLElement>('[data-step]'));
  let raf = 0;
  const update = () => {
    raf = 0;
    const vh = window.innerHeight;
    let a = 0;
    steps.forEach((s, i) => {
      if (s.getBoundingClientRect().top < vh * 0.6) a = i;
    });
    steps.forEach((s, i) => {
      s.classList.toggle('is-done', i <= a);
      s.classList.toggle('is-current', i === a);
      s.classList.toggle('is-past', i < a);
    });
  };
  window.addEventListener('scroll', () => (raf ||= requestAnimationFrame(update)), { passive: true });
  update();
</script>

<style>
  .sc-hero {
    background: var(--bg);
    border-bottom: 1px solid rgba(var(--ink), 0.1);
    padding-inline: var(--gutter);
    padding-bottom: clamp(56px, 7vw, 84px);
  }
  .sc-h1 {
    max-width: 820px;
  }
  .sc-sub {
    margin: 20px 0 0;
    font-size: clamp(16px, 1.5vw, 18.5px);
    line-height: 1.65;
    color: rgba(var(--ink), 0.7);
    max-width: 620px;
  }
  .sc-intro {
    margin: 16px 0 0;
    font-size: 15.5px;
    line-height: 1.7;
    color: rgba(var(--ink), 0.68);
    max-width: 720px;
  }
  .sc-proc__h {
    margin: 0;
    max-width: 640px;
  }
  .sc-steps {
    list-style: none;
    padding: 0;
    margin: 48px 0 0;
    display: flex;
    flex-direction: column;
  }
  .sc-step {
    position: relative;
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: clamp(18px, 3vw, 36px);
    padding: 26px 0;
    scroll-margin-top: 120px;
  }
  .sc-step__rail {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .sc-step__n {
    flex: none;
    width: 52px;
    height: 52px;
    border-radius: 16px;
    background: #16301f;
    color: var(--sand);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--f-mono);
    font-size: 14px;
    font-weight: 600;
    box-shadow: 0 10px 22px rgba(22, 48, 31, 0.25);
    transition:
      background 0.45s,
      color 0.45s,
      transform 0.45s;
  }
  .sc-step:global(.is-done) .sc-step__n {
    background: var(--gold-500);
    color: var(--green-deep);
  }
  .sc-step:global(.is-current) .sc-step__n {
    transform: scale(1.08);
  }
  .sc-step__line {
    flex: 1;
    width: 2px;
    margin-top: 10px;
    border-radius: 2px;
    background: rgba(166, 127, 46, 0.2);
    transition: background 0.45s;
  }
  .sc-step:global(.is-past) .sc-step__line {
    background: var(--gold-500);
  }
  .sc-step__card {
    border: 1px solid rgba(var(--ink), 0.13);
    border-radius: 18px;
    background: rgba(var(--surf), 0.75);
    padding: 24px clamp(20px, 3vw, 32px);
    transition:
      border-color 0.35s,
      box-shadow 0.35s;
  }
  .sc-step:global(.is-current) .sc-step__card,
  .sc-step__card:hover {
    border-color: rgba(166, 127, 46, 0.6);
    box-shadow: 0 18px 36px rgba(var(--ink), 0.1);
  }
  .sc-step__card h3 {
    margin: 0;
    font-size: clamp(17px, 1.8vw, 20px);
    font-weight: 730;
    line-height: 1.35;
  }
  .sc-step__card p {
    margin: 10px 0 0;
    font-size: 14.5px;
    line-height: 1.65;
    color: rgba(var(--ink), 0.68);
    max-width: 680px;
  }
  .sc-certs {
    background: #122619;
  }
  .sc-certs__h {
    max-width: 640px;
  }
  .sc-certs__note {
    margin: 40px auto 0;
    max-width: 640px;
    text-align: center;
    font-size: 14.5px;
    line-height: 1.7;
    color: rgba(238, 230, 205, 0.62);
  }
  .sc-certs__cta {
    margin-top: 28px;
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }
</style>
