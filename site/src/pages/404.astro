---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ui } from '@/i18n/ui';

const en = ui('en');
const ar = ui('ar');
---

<BaseLayout locale="en" path="/404" title={en.meta.notFound.title} description={en.meta.notFound.description} noindex>
  <section class="nf">
    <div class="nf__in">
      <span class="nf__code" aria-hidden="true">
        404
      </span>
      <h1 class="h1 nf__h">{en.notFound.title}</h1>
      <p class="nf__p">{en.notFound.body}</p>
      <p class="nf__p nf__ar" lang="ar" dir="rtl">
        {ar.notFound.title} — {ar.notFound.body}
      </p>
      <div class="nf__btns">
        <a href="/" class="btn btn--primary">
          {en.notFound.home}
        </a>
        <a href="/ar" class="btn btn--outline" lang="ar" hreflang="ar">
          {ar.notFound.home}
        </a>
        <a href="/recipes" class="btn btn--outline">
          {en.notFound.recipes}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    min-height: 80vh;
    display: grid;
    place-items: center;
    padding: calc(var(--header-h) + 40px) var(--gutter) 80px;
    text-align: center;
  }
  .nf__code {
    font-family: var(--f-display);
    font-size: clamp(90px, 18vw, 180px);
    font-weight: 800;
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 2px rgba(166, 127, 46, 0.5);
  }
  .nf__h {
    margin-top: 18px;
  }
  .nf__p {
    margin: 12px auto 0;
    max-width: 480px;
    color: rgba(var(--ink), 0.7);
  }
  .nf__btns {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 28px;
  }
</style>
